CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8080/'
app.indexPage = ''
app.defaultLocale = 'id'
app.appTimezone = 'Asia/Jakarta'

# MySQL / MariaDB (database tetap berada di hosting/server aplikasi)
database.default.hostname = '127.0.0.1'
database.default.database = 'mulyorejeki'
database.default.username = 'mulyorejeki'
database.default.password = ''
database.default.DBDriver = 'MySQLi'
database.default.DBPrefix = ''
database.default.port = 3306

# Seed akun admin. Isi hanya saat menjalankan `php spark db:seed DatabaseSeeder`.
admin.seed.name = 'Administrator'
admin.seed.email = 'admin@example.com'
admin.seed.password = 'CHANGE_ME_STRONG_PASSWORD'

# Storage development: gambar disimpan di public/uploads.
storage.driver = 'local'
# storage.localRoot = '/absolute/path/to/project/public/uploads'

# Cloudflare R2 / S3-compatible storage.
# Ubah storage.driver menjadi r2 saat kredensial sudah siap.
# storage.driver = 'r2'
storage.r2.endpoint = 'https://<ACCOUNT_ID>.r2.cloudflarestorage.com'
storage.r2.bucket = 'mulyorejeki'
storage.r2.accessKey = ''
storage.r2.secretKey = ''
storage.r2.region = 'auto'
# Gunakan custom domain atau public R2 URL, tanpa slash di akhir.
storage.r2.publicBaseUrl = 'https://cdn.example.com'
